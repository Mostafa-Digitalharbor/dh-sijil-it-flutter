<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- XML-RPC calls to the customer's Odoo instance. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Warranty reminders. Android 13+ makes notifications opt-in, and the
         app asks only when the user turns the switch on in Settings, so the
         prompt is attached to the thing that needs it. No exact-alarm
         permission is declared: reminders are scheduled inexactly on purpose,
         because "some time that morning" is the right precision for a
         warranty that expires in a month. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Android drops every scheduled alarm on reboot, so without this the
         warranty reminders quietly stop existing until the app is next opened.
         A reminder for a warranty expiring in three weeks is precisely the one
         nobody is opening the app to check, which is what makes this the
         difference between the feature working and only appearing to. Paired
         with the plugin's ScheduledNotificationBootReceiver below. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Settings -> Require unlock. USE_BIOMETRIC is a normal permission, so
         it is granted at install and never prompts; without it AndroidX's
         BiometricPrompt refuses to show. The prompt also accepts the device
         PIN, pattern or password, which is what keeps the setting usable for
         somebody the fingerprint sensor will not read. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- QR / barcode scanning (spec sections 12 and 13). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <!-- Dictating a search instead of typing it. A technician holding a laptop
         in one hand has no second hand for a keyboard, and the search field is
         the way into every screen in the product.

         Asked for by `speech_to_text` at the moment the microphone button is
         pressed, the same way the camera is asked for by the scanner — which
         is what keeps the prompt attached to the action that needs it.

         `required="false"` on the feature: an emulator or a tablet without a
         microphone must still install and run, with the button simply absent.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- enableOnBackInvokedCallback: Android 13+ predictive back. Without it
         the platform logs "OnBackInvokedCallback is not enabled for the
         application" on every launch and falls back to the legacy
         KEYCODE_BACK path, so the screens that intercept back — the sign-in
         screen, and every form that asks before discarding — get neither the
         back preview nor the system animation the rest of the OS uses.
         Flutter routes its `PopScope` through the new API from 3.24 on. -->
    <!-- allowBackup: off, deliberately, and it is the one setting that has to
         stay off. The Hive boxes hold cached employees, asset assignments and
         the outbox, protected on disk by Android's own file-based encryption.
         Left at its default of true, `adb backup` and Auto Backup would copy
         those files off the device and out from behind that protection — the
         one real extraction path on Android, and the gap the app's own AES
         cipher used to paper over before it was removed for export-compliance
         reasons (see ios/Runner/Info.plist). Nothing here is worth backing up
         anyway: every box is rebuilt from Odoo on the next refresh, and the
         credentials live in EncryptedSharedPreferences, not here. -->
    <application
        android:label="Sijil IT"
        android:name="${applicationName}"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Fetch the barcode model when the app installs, not on first scan.

             The model is no longer compiled into the APK (see
             `dev.steenbakker.mobile_scanner.useUnbundled` in
             android/gradle.properties), which saves 4 MB per device but leaves
             Play Services to supply it. Without this line it is fetched lazily,
             so the very first scan a technician attempts — usually standing in
             front of the asset, often on office Wi-Fi they have not joined yet
             — is the one that waits for a download. With it, Play Services has
             the model before the app is ever opened. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />
        <!-- Re-arms the reminders the plugin had scheduled before the device
             restarted or the app was replaced by an update. `exported="false"`:
             only the system broadcasts these actions, so nothing else needs to
             reach it. QUICKBOOT_POWERON covers HTC and a number of Chinese
             ROMs that send their own action instead of BOOT_COMPLETED. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The employee profile's Email and Call actions. Android 11+ hides
             other packages by default, so without these url_launcher cannot
             resolve a handler and the buttons fail silently. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Voice search. Android 11+ hides other packages by default, and
             `speech_to_text` binds to whichever app provides the recogniser —
             so without this it reports "speech recognition unavailable" on
             every device, including ones that have it. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
