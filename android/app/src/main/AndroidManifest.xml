<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- XML-RPC calls to the customer's Odoo instance. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Warranty reminders. Android 13+ makes notifications opt-in, and the
         app asks only when the user turns the switch on in Settings, so the
         prompt is attached to the thing that needs it. No exact-alarm
         permission is declared: reminders are scheduled inexactly on purpose,
         because "some time that morning" is the right precision for a
         warranty that expires in a month. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- QR / barcode scanning (spec sections 12 and 13). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <!-- enableOnBackInvokedCallback: Android 13+ predictive back. Without it
         the platform logs "OnBackInvokedCallback is not enabled for the
         application" on every launch and falls back to the legacy
         KEYCODE_BACK path, so the screens that intercept back — the sign-in
         screen, and every form that asks before discarding — get neither the
         back preview nor the system animation the rest of the OS uses.
         Flutter routes its `PopScope` through the new API from 3.24 on. -->
    <application
        android:label="Sijil IT"
        android:name="${applicationName}"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Fetch the barcode model when the app installs, not on first scan.

             The model is no longer compiled into the APK (see
             `dev.steenbakker.mobile_scanner.useUnbundled` in
             android/gradle.properties), which saves 4 MB per device but leaves
             Play Services to supply it. Without this line it is fetched lazily,
             so the very first scan a technician attempts — usually standing in
             front of the asset, often on office Wi-Fi they have not joined yet
             — is the one that waits for a download. With it, Play Services has
             the model before the app is ever opened. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The employee profile's Email and Call actions. Android 11+ hides
             other packages by default, so without these url_launcher cannot
             resolve a handler and the buttons fail silently. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
