<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Sijil IT uses the camera to scan asset QR codes and barcodes.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Sijil IT asks for Face ID before it opens, so company assets cannot be reassigned from an unlocked phone.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sijil IT attaches photos to asset return records.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sijil IT lets you dictate a search instead of typing it, so you can look an asset up with one hand.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Sijil IT turns what you say into a search for an asset or an employee.</string>
	<!--
	  Export compliance, answered here once instead of by hand on every upload.

	  App Store Connect asks whether the app uses non-exempt encryption every
	  time a build is processed, and holds the build until somebody answers.
	  This key is that answer, in the repository, where it can be reviewed
	  against the code rather than remembered.

	  "false" is accurate only because the app carries no encryption of its
	  own. What it has:

	    - HTTPS to the Odoo server, via the OS network stack — exempt.
	    - Credentials in the Keychain, via flutter_secure_storage — the
	      operating system's own encryption, exempt.
	    - Face ID / passcode through LocalAuthentication — the OS again.
	    - The Hive cache, encrypted at rest by iOS Data Protection because
	      every file in the container is, with no cipher of ours on top.

	  That last line is a decision, not an accident. The cache used to be
	  wrapped in HiveAesCipher — an AES implementation shipped inside the app
	  rather than taken from iOS, which is exactly the "standard encryption
	  algorithms in addition to the encryption within Apple's operating
	  system" case that makes an app non-exempt and drags every release into
	  an export filing. It was removed for that reason; the reasoning in full
	  is in lib/core/storage/cache/hive_cache_store.dart.

	  So: if anyone ever adds a cipher, a key-derivation function, or a crypto
	  package to this app, this key has to change to true and the compliance
	  paperwork starts. Do not flip it back to false to make a build go
	  through.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sijil IT</string>
	<!--
	  The icon set inside Assets.xcassets, named explicitly.

	  Xcode normally writes this key itself: `actool` injects it into the built
	  Info.plist from ASSETCATALOG_COMPILER_APPICON_NAME. "Normally" is the
	  problem — it is the one part of the icon pipeline that leaves no trace in
	  the repository, so when App Store Connect showed the placeholder tile
	  instead of the mark there was nothing to inspect. Writing it here makes
	  the setting reviewable, and makes it survive a project file that has
	  already been damaged once (see the note in project.pbxproj).

	  App Store Connect reads this key to find the icon for TestFlight and for
	  the product page. Without it the build still installs and still shows its
	  icon on the home screen, which is exactly why the gap is easy to miss.
	-->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>sijil_it</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
